# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-store/

# next.js
/.next/
/out/

# production
/build
/dist

# testing
/coverage
.vitest/

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep an example file if one is added)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# certificates
*.pem

# picture pack review sheets (pnpm packs trace / sheet)
.pack-review/

# caches
.turbo
.eslintcache

# editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
.v0-scratch/
