# Copy to .env.local for local development and fill in the values. Never commit real values.
# On Vercel these are set in Project → Settings → Environment Variables.

# Supabase (Project Settings → API). Required everywhere.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security: used by the Stripe webhook and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: server-side Supabase URL if it differs from the public one.
SUPABASE_URL=

# Stripe. Production needs live keys (sk_live_/pk_live_); everywhere else needs test keys
# (sk_test_/pk_test_). A key from the wrong mode is refused, never used.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secrets: STRIPE_LIVE_WEBHOOK_SECRET in production, STRIPE_WEBHOOK_SECRET elsewhere.
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# Optional: where sign-in emails send people back to, for local development.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Set automatically by Vercel; don't add these yourself.
# VERCEL_ENV        production | preview | development. Decides live vs test payments.
# NODE_ENV          production in builds. Turns on Vercel Web Analytics on grown-up pages.
